# ---------------------------------------------------------------------------
# 机器相关与本地生成产物：不入库
# ---------------------------------------------------------------------------

# 运行时探测结果（python 解释器路径、EPLAN Platform 根目录，均由 setup.ps1 生成）
runtime/

# 离线文档索引库（体积大，且由 scripts/build-*.py 从本机/官方站点重建）
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal

# 抓取 / 逆向 / 调研过程的中间产物
_recon/

# Python 字节码
__pycache__/
*.py[cod]

# 编辑器与系统杂物
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# vendored eplan-mcp runtime scratch (created by the server at run time;
# the two .gitkeep files are shipped as empty placeholders upstream)
vendor/eplan-mcp/eplan-p8-mcp-server/mcp_server/scripts/generated/
vendor/eplan-mcp/eplan-p8-mcp-server/mcp_server/scripts/results/
# 安装/构建过程中被误建的占位目录（例如某个工具把空路径拼成了 "undefined"）
/undefined/

# Release 附件是本地产物，下载后落在仓库根，不入库
/DSH_Eplan-offline-indexes.zip

# 发版时临时写的发布说明
/.release-notes.md

# vendor 子进程可能写出的日志目录
/vendor/**/logs/
