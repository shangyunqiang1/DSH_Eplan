{
  "name": "dsh-eplan",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "EPLAN Electric P8 integration for DeepSeek Harness: a bundled local EPLAN automation MCP server, an offline P8 2025 .NET API reference and platform guide built from the installed docs, and offline 2026 / 2027 / EEC Pro documentation lookups (those three ship disabled and read indexes extracted from the release assets).",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shangyunqiang1/DSH_Eplan.git"
  },
  "homepage": "https://github.com/shangyunqiang1/DSH_Eplan#readme",
  "bugs": {
    "url": "https://github.com/shangyunqiang1/DSH_Eplan/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./mcp/*/locale/en.json": "./mcp/*/locale/en.json",
    "./mcp/*/locale/zh.json": "./mcp/*/locale/zh.json",
    "./mcp/*": "./mcp/*/index.js"
  },
  "files": [
    "index.js",
    "client.js",
    "versions.json",
    "mcp/*/index.js",
    "mcp/*/locale/*.json",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**/*.md",
    "server/**/*.py",
    "server/**/*.md",
    "scripts/*",
    "vendor/**",
    "data/README.md",
    "README.md",
    "LICENSE",
    "licenses/*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "eplan",
    "eplan-electric-p8",
    "eec-pro",
    "mcp"
  ],
  "license": "MIT"
}